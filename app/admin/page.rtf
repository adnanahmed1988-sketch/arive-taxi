import \{ supabase \} from "@/lib/supabase";\
\
export const dynamic = "force-dynamic";\
\
export default async function AdminPage() \{\
  const \{ data: bookings, error \} = await supabase\
    .from("bookings")\
    .select("*")\
    .order("created_at", \{ ascending: false \});\
\
  if (error) \{\
    return (\
      <main className="min-h-screen bg-black p-8 text-[#F2DFBC]">\
        <h1 className="text-3xl font-semibold">Arive Admin</h1>\
        <p className="mt-4 text-red-400">Could not load bookings.</p>\
      </main>\
    );\
  \}\
\
  return (\
    <main className="min-h-screen bg-black p-8 text-[#F2DFBC]">\
      <h1 className="text-4xl font-semibold">Bookings Dashboard</h1>\
\
      <div className="mt-8 overflow-x-auto rounded-2xl border border-[#D4AF37]/20">\
        <table className="w-full min-w-[1100px] text-left">\
          <thead className="bg-[#111] text-xs uppercase tracking-[0.2em] text-[#D4AF37]">\
            <tr>\
              <th className="p-4">ID</th>\
              <th className="p-4">Status</th>\
              <th className="p-4">Customer</th>\
              <th className="p-4">Phone</th>\
              <th className="p-4">Email</th>\
              <th className="p-4">Date</th>\
              <th className="p-4">Time</th>\
              <th className="p-4">Pickup</th>\
              <th className="p-4">Destination</th>\
              <th className="p-4">Price</th>\
            </tr>\
          </thead>\
\
          <tbody>\
            \{bookings?.map((booking) => (\
              <tr key=\{booking.id\} className="border-t border-[#D4AF37]/10 text-sm">\
                <td className="p-4">\{booking.id\}</td>\
                <td className="p-4">\{booking.status\}</td>\
                <td className="p-4">\{booking.full_name\}</td>\
                <td className="p-4">\{booking.phone\}</td>\
                <td className="p-4">\{booking.email\}</td>\
                <td className="p-4">\{booking.journey_date\}</td>\
                <td className="p-4">\{booking.journey_time\}</td>\
                <td className="p-4">\{booking.pickup\}</td>\
                <td className="p-4">\{booking.destination\}</td>\
                <td className="p-4">\'a3\{booking.price\}</td>\
              </tr>\
            ))\}\
          </tbody>\
        </table>\
      </div>\
    </main>\
  );\
\}\
EOF}